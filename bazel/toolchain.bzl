"""xnu Bazel C++ toolchain.

The compiler, linker and binutils are not taken from /usr/bin any more: they
are built from the local llvm-project checkout through the LLVM Bazel overlay
(`@llvm-project`, see //bazel:llvm_source.bzl).  The tool binaries are built for
this Linux host (see `tool_binary` below), and their execroot-relative artifact
paths are used as the legacy `tool_path` values.

`cc_toolchain` (root package) and `cc_toolchain_config` (here) must agree on the
configuration the tool artifacts live in; both are therefore pinned to
`//bazel:linux_x86_64` by the transition below.
"""

load("@rules_cc//cc:action_names.bzl", "ACTION_NAMES")
load("@rules_cc//cc/common:cc_common.bzl", "cc_common")
load(
    "@rules_cc//cc:cc_toolchain_config_lib.bzl",
    "feature",
    "flag_group",
    "flag_set",
    "tool_path",
)

_TARGET = "x86_64-apple-darwin"

# The toolchain's tool binaries are built from the llvm-project sources.  To
# avoid a configuration cycle (the tool binaries would otherwise be built for
# the macOS target platform, using the very toolchain we are defining), force
# them into a Linux target configuration, where Bazel's auto-configured host
# C++ toolchain is used.  Bazel's `cfg = "exec"` is not enough here: when
# `cc_toolchain` pulls in its `*_files` attributes during configuration of the
# target platform, the exec transition ends up keeping that target platform.
def _linux_transition_impl(settings, attr):
    return {"//command_line_option:platforms": "//bazel:linux_x86_64"}

_linux_transition = transition(
    implementation = _linux_transition_impl,
    inputs = [],
    outputs = ["//command_line_option:platforms"],
)

def _tool_binary_impl(ctx):
    return [DefaultInfo(files = depset(ctx.files.binary))]

tool_binary = rule(
    implementation = _tool_binary_impl,
    attrs = {
        "binary": attr.label(
            allow_files = True,
            cfg = _linux_transition,
            mandatory = True,
        ),
    },
)

def _impl(ctx):
    clang = ctx.file.clang
    resource_dir = "/".join(ctx.files.clang_headers[0].dirname.split("/")[:-1])
    include_dir = ctx.files.clang_headers[0].dirname

    tool_paths = [
        tool_path(name = "gcc", path = clang.path),
        tool_path(name = "ld", path = ctx.file.ld.path),
        tool_path(name = "ar", path = ctx.file.ar.path),
        tool_path(name = "cpp", path = clang.path),
        tool_path(name = "gcov", path = "/bin/false"),
        tool_path(name = "nm", path = ctx.file.nm.path),
        tool_path(name = "objdump", path = ctx.file.objdump.path),
        tool_path(name = "strip", path = ctx.file.strip.path),
    ]

    features = [
        feature(
            name = "default_compile_flags",
            enabled = True,
            flag_sets = [
                flag_set(
                    actions = [
                        ACTION_NAMES.assemble,
                        ACTION_NAMES.preprocess_assemble,
                        ACTION_NAMES.linkstamp_compile,
                        ACTION_NAMES.c_compile,
                        ACTION_NAMES.cpp_compile,
                        ACTION_NAMES.cpp_header_parsing,
                        ACTION_NAMES.cpp_module_compile,
                        ACTION_NAMES.cpp_module_codegen,
                        ACTION_NAMES.lto_backend,
                        ACTION_NAMES.clif_match,
                    ],
                    flag_groups = [
                        flag_group(
                            flags = [
                                "-target", _TARGET,
                                "-nostdlibinc",
                                # The in-tree clang is run straight from
                                # bazel-out, so it cannot discover its resource
                                # directory next to the executable.  Point it at
                                # the builtin headers generated by the overlay.
                                "-resource-dir", resource_dir,
                            ],
                        ),
                    ],
                ),
            ],
        ),
        feature(
            name = "default_linker_flags",
            enabled = True,
            flag_sets = [
                flag_set(
                    actions = [ACTION_NAMES.cpp_link_executable, ACTION_NAMES.cpp_link_dynamic_library, ACTION_NAMES.cpp_link_nodeps_dynamic_library],
                    flag_groups = ([
                        flag_group(
                            flags = [
                                "-target", _TARGET,
                                "-fuse-ld=lld",
                                "-B", ctx.file.ld.dirname,
                            ],
                        ),
                    ]),
                ),
            ],
        ),
    ]

    return cc_common.create_cc_toolchain_config_info(
        ctx = ctx,
        features = features,
        cxx_builtin_include_directories = [include_dir],
        toolchain_identifier = "xnu-toolchain",
        host_system_name = "local",
        target_system_name = _TARGET,
        target_cpu = "x86_64",
        target_libc = "macosx",
        compiler = "clang",
        abi_version = "unknown",
        abi_libc_version = "unknown",
        tool_paths = tool_paths,
    )

cc_toolchain_config = rule(
    implementation = _impl,
    attrs = {
        "clang": attr.label(allow_single_file = True, cfg = _linux_transition, mandatory = True),
        "ld": attr.label(allow_single_file = True, cfg = _linux_transition, mandatory = True),
        "ar": attr.label(allow_single_file = True, cfg = _linux_transition, mandatory = True),
        "nm": attr.label(allow_single_file = True, cfg = _linux_transition, mandatory = True),
        "objdump": attr.label(allow_single_file = True, cfg = _linux_transition, mandatory = True),
        "strip": attr.label(allow_single_file = True, cfg = _linux_transition, mandatory = True),
        "clang_headers": attr.label(allow_files = True, cfg = _linux_transition, mandatory = True),
    },
)
